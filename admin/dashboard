<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>教師管理後台 · 互動美語 X 如苑</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet">
  <style>
    html, body, div, span, header, nav, main, section, input, button, textarea, select, h1, h2, h3, p, label {
      box-sizing: border-box; margin: 0; padding: 0;
    }
    :root {
      --gold: #C9A84C;
      --gold-light: #E8C97A;
      --gold-dim: #8A6E30;
      --black: #0D0D0D;
      --surface: #161616;
      --surface2: #1F1F1F;
      --border: rgba(201,168,76,0.25);
      --text-main: #F0EAD6;
      --text-muted: #9A9180;
      --radius: 12px;
      --font-serif: 'Playfair Display','Noto Serif TC',serif;
    }
    html, body {
      min-height: 100%;
      background: var(--black);
      color: var(--text-main);
      font-family: -apple-system, 'Noto Sans TC', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 1.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-title { font-family: var(--font-serif); font-size: 20px; color: var(--gold-light); }
    .header-sub { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
    .logout-btn {
      background: transparent; border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 16px; color: var(--text-muted); font-size: 13px; cursor: pointer;
      transition: 0.2s;
    }
    .logout-btn:hover { border-color: var(--gold); color: var(--gold); }

    .container {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      gap: 2rem;
    }

    nav.sidebar {
      width: 200px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .nav-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 12px 16px;
      border-radius: var(--radius);
      text-align: left;
      cursor: pointer;
      font-size: 14px;
      transition: 0.2s;
    }
    .nav-btn:hover { background: var(--surface2); }
    .nav-btn.active { background: var(--gold); color: var(--black); font-weight: 600; border-color: var(--gold); }

    #nav-super-btn {
      display: block;
      border: 1px solid rgba(232,201,122,0.4);
      color: var(--gold-light);
    }

    main.content {
      flex: 1;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      min-height: 500px;
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .section-title {
      font-family: var(--font-serif); font-size: 18px; color: var(--gold);
      margin-bottom: 1.5rem; display: flex; align-items: center; gap: 8px;
    }
